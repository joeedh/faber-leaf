    "entryPoints": [
      {"in": "sculptcore/typescript/build/sculptcore-browser.wasm", "out": "sculptcore-browser"},
      {"in": "sculptcore/typescript/build/sculptcore-browser.js", "out": "sculptcore-browser"}
    ],
    "external": ["*/build/sculptcore.js"]
  }
}
